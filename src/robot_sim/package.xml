<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_sim</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic simulation: circuit2 world, TurtleBot3 Burger placeholder, ros_gz bridge and sim launch.</description>
  <maintainer email="cinarozturk198@gmail.com">Çınar Öztürk</maintainer>
  <license>Apache-2.0</license>
  <license>GPL-3.0-only</license> <!-- models/Circuit_ql_2 only -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>autonom_bringup</exec_depend>
  <exec_depend>autonom_description</exec_depend>
  <exec_depend>autonom_hardware</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>
  <exec_depend>nav2_graceful_controller</exec_depend>
  <exec_depend>nav2_theta_star_planner</exec_depend>
  <exec_depend>autonom_localization</exec_depend>
  <exec_depend>turtlebot3_description</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
