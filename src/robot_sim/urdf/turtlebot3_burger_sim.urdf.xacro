<?xml version="1.0"?>
<!-- Placeholder robot: stock TurtleBot3 Burger URDF (vendored turtlebot3_description) + Gazebo Harmonic systems.
     The LDS-01 is replaced by an RPLiDAR S3-spec sensor so SLAM/Nav2 tuning transfers to the real robot. -->
<robot name="turtlebot3_burger" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find turtlebot3_description)/urdf/turtlebot3_burger.urdf"/>
  <xacro:include filename="$(find autonom_description)/urdf/gz_plugins.xacro"/>

  <!-- Kinematics match turtlebot3_gazebo's burger model. -->
  <xacro:gz_diff_drive left_joint="wheel_left_joint" right_joint="wheel_right_joint"
                       wheel_separation="0.160" wheel_radius="0.033" base_frame="base_footprint"
                       max_linear_velocity="0.22" max_angular_velocity="2.84"/>
  <xacro:gz_joint_state_publisher left_joint="wheel_left_joint" right_joint="wheel_right_joint"/>
  <xacro:gz_rplidar_s3 link="base_scan"/>
  <xacro:gz_imu link="imu_link" update_rate="200"/>
  <xacro:gz_ground_truth base_frame="base_footprint"/>
  <xacro:gz_frictionless link="caster_back_link"/>

</robot>
