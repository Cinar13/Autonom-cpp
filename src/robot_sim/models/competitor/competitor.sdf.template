<?xml version="1.0"?>
<!-- Simulated competitor robot (docs/07): 12 cm x 12 cm footprint (docs/07 allows up to 15 x 15), differential drive, 0.25 m tall so both the
     TurtleBot3's LiDAR (0.18 m) and the real robot's (0.11 m) see it. Template: launch/fibonacci_simulation.launch.py
     replaces __NAME__ with the model name, giving each competitor its own topics:
       /__NAME__/cmd_vel   geometry Twist in (bridged from ROS)
       /__NAME__/odom      ground-truth odometry out (OdometryPublisher, world frame; bridged to ROS)
     The DiffDrive TF and wheel odometry stay on private Gazebo topics, never on /tf (the EKF owns odom->base). -->
<sdf version="1.9">
  <model name="__NAME__">
    <link name="base_link">
      <pose>0 0 0.135 0 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.0048</ixx><iyy>0.0048</iyy><izz>0.00192</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="body">
        <geometry><box><size>0.12 0.12 0.24</size></box></geometry>
      </collision>
      <visual name="body">
        <geometry><box><size>0.12 0.12 0.24</size></box></geometry>
        <material><ambient>0.85 0.45 0.05 1</ambient><diffuse>0.85 0.45 0.05 1</diffuse></material>
      </visual>
      <!-- Frictionless skids front and back carry the body; the wheels drive. -->
      <collision name="skid_front">
        <pose>0.04 0 -0.125 0 0 0</pose>
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="skid_rear">
        <pose>-0.04 0 -0.125 0 0 0</pose>
        <geometry><sphere><radius>0.01</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="wheel_left">
      <pose>0 0.0475 0.025 -1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1.6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="tyre">
        <geometry><cylinder><radius>0.025</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="tyre">
        <geometry><cylinder><radius>0.025</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="wheel_right">
      <pose>0 -0.0475 0.025 -1.5708 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1.6e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="tyre">
        <geometry><cylinder><radius>0.025</radius><length>0.02</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="tyre">
        <geometry><cylinder><radius>0.025</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_left</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_right</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.095</wheel_separation>
      <wheel_radius>0.025</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <topic>/__NAME__/cmd_vel</topic>
      <odom_topic>/__NAME__/wheel_odom</odom_topic>
      <tf_topic>/__NAME__/tf</tf_topic>
      <frame_id>__NAME__/odom</frame_id>
      <child_frame_id>__NAME__/base_link</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>__NAME__/base_link</robot_base_frame>
      <odom_topic>/__NAME__/odom</odom_topic>
      <tf_topic>/__NAME__/odom_tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
