<?xml version="1.0"?>
<!--
  Gazebo Harmonic systems shared by every robot description used in simulation.
  Topic contract with robot_sim/config/bridge.yaml:
    cmd_vel (in), odom, joint_states, scan, imu, /sim/tf (DiffDrive TF, kept off /tf so the EKF owns odom->base).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gz_diff_drive" params="left_joint right_joint wheel_separation wheel_radius base_frame
                                            max_linear_velocity max_angular_velocity">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>${left_joint}</left_joint>
        <right_joint>${right_joint}</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <max_linear_velocity>${max_linear_velocity}</max_linear_velocity>
        <max_angular_velocity>${max_angular_velocity}</max_angular_velocity>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <tf_topic>/sim/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>${base_frame}</child_frame_id>
        <odom_publisher_frequency>30</odom_publisher_frequency>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="gz_joint_state_publisher" params="left_joint right_joint">
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <update_rate>50</update_rate>
        <joint_name>${left_joint}</joint_name>
        <joint_name>${right_joint}</joint_name>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="gz_lidar" params="link samples update_rate range_min range_max">
    <gazebo reference="${link}">
      <sensor name="lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>${update_rate}</update_rate>
        <topic>scan</topic>
        <gz_frame_id>${link}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${samples}</samples>
              <resolution>1.0</resolution>
              <min_angle>${-pi}</min_angle>
              <max_angle>${pi - 2.0 * pi / samples}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${range_min}</min>
            <max>${range_max}</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- RPLiDAR S3 datasheet: 32 kHz sample rate, 0.1125 deg resolution (3200 samples/rev -> 10 Hz), 0.05-40 m. -->
  <xacro:property name="rplidar_s3_samples" value="3200"/>
  <xacro:property name="rplidar_s3_scan_rate" value="10"/>
  <xacro:property name="rplidar_s3_range_min" value="0.05"/>
  <xacro:property name="rplidar_s3_range_max" value="40.0"/>

  <xacro:macro name="gz_rplidar_s3" params="link">
    <xacro:gz_lidar link="${link}" samples="${rplidar_s3_samples}" update_rate="${rplidar_s3_scan_rate}"
                    range_min="${rplidar_s3_range_min}" range_max="${rplidar_s3_range_max}"/>
  </xacro:macro>

  <xacro:macro name="gz_imu" params="link update_rate">
    <gazebo reference="${link}">
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <topic>imu</topic>
        <gz_frame_id>${link}</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Passive casters must slide, otherwise they act as a brake and corrupt the odometry. -->
  <xacro:macro name="gz_frictionless" params="link">
    <gazebo reference="${link}">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

</robot>
